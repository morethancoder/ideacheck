# Copy to .env (never committed). Only the backend you use needs its key.
# ideacheck reads keys from the environment only — never from config files.

# structured backend, provider: anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# structured / logprob via OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# jev backend (TypeSafe) — https://typesafe.ai; the tool works without it
TYPESAFE_API_KEY=
